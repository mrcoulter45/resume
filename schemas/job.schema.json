{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "job",
  "type": "object",
  "required": [
    "schema_version",
    "company",
    "role",
    "example",
    "source",
    "source_sha256",
    "captured",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "company": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "example": {
      "type": "boolean"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "captured": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "importance",
          "terms",
          "locator"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "importance": {
            "enum": [
              "required",
              "preferred",
              "responsibility"
            ]
          },
          "terms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
